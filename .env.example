# ==============================================
# OmniFlow RWA Platform - Environment Variables
# ==============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ==============================================
# Blockchain Networks & RPCs
# ==============================================

# Ethereum Mainnet/Testnet
INFURA_API_KEY=your_infura_api_key_here
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/${INFURA_API_KEY}
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/${INFURA_API_KEY}

# Polygon
POLYGON_RPC_URL=https://polygon-mainnet.infura.io/v3/${INFURA_API_KEY}
MUMBAI_RPC_URL=https://polygon-mumbai.infura.io/v3/${INFURA_API_KEY}

# Binance Smart Chain
BSC_RPC_URL=https://bsc-dataseed1.binance.org/
BSC_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545/

# OneChain
ONECHAIN_RPC_MAINNET=https://rpc.mainnet.onelabs.cc:443
ONECHAIN_RPC_TESTNET=https://rpc-testnet.onelabs.cc:443
ONECHAIN_FAUCET=https://faucet-testnet.onelabs.cc:443

# Solana
SOLANA_PRIVATE_KEY=your_solana_private_key_base58
NEXT_PUBLIC_SOLANA_RPC_ENDPOINT=https://api.devnet.solana.com
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# SUI (if needed)
SUI_RPC_TESTNET=https://fullnode.testnet.sui.io:443
SUI_RPC_MAINNET=https://fullnode.mainnet.sui.io:443
SUI_PRIVATE_KEY=your_sui_private_key_here

# ==============================================
# Private Keys & Wallet Configuration
# ==============================================

# CRITICAL: Use a dedicated deployment wallet, NEVER your personal wallet
# For testnet/development, use a wallet with minimal funds
PRIVATE_KEY=your_private_key_here

# Bridge Operator Key (for cross-chain operations)
BRIDGE_OPERATOR_PRIVATE_KEY=your_bridge_operator_key

# ==============================================
# Contract Verification API Keys
# ==============================================

ETHERSCAN_API_KEY=your_etherscan_api_key_here
POLYGONSCAN_API_KEY=your_polygonscan_api_key_here
BSCSCAN_API_KEY=your_bscscan_api_key_here

# ==============================================
# AI Services
# ==============================================

# OpenAI (for AI Due Diligence)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic Claude (for AI Risk Assessment)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini (alternative AI provider)
GEMINI_API_KEY=your_gemini_api_key_here

# ==============================================
# Web3 Authentication & Wallet Services
# ==============================================

# Web3Auth
NEXT_PUBLIC_WEB3AUTH_CLIENT_ID=your_web3auth_client_id
NEXT_PUBLIC_WEB3AUTH_VERIFIER_NAME=your_verifier_name
WEB3AUTH_CLIENT_SECRET=your_web3auth_client_secret

# WalletConnect
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=your_walletconnect_project_id

# ThirdWeb
NEXT_PUBLIC_THIRDWEB_CLIENT_ID=your_thirdweb_client_id

# MetaMask SDK
NEXT_PUBLIC_INFURA_API_KEY=your_infura_api_key

# ==============================================
# Social Login Configuration (Optional)
# ==============================================

NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id
NEXT_PUBLIC_FACEBOOK_CLIENT_ID=your_facebook_client_id
NEXT_PUBLIC_TWITTER_CLIENT_ID=your_twitter_client_id
NEXT_PUBLIC_DISCORD_CLIENT_ID=your_discord_client_id
NEXT_PUBLIC_APPLE_CLIENT_ID=your_apple_client_id

# ==============================================
# Decentralized Storage
# ==============================================

# IPFS / Infura
IPFS_PROJECT_ID=your_infura_ipfs_project_id
IPFS_PROJECT_SECRET=your_infura_ipfs_secret

# Pinata
PINATA_API_KEY=your_pinata_api_key
PINATA_SECRET_KEY=your_pinata_secret_key

# Arweave
ARWEAVE_WALLET_KEY=your_arweave_wallet_key_json
NEXT_PUBLIC_ARWEAVE_GATEWAY=https://arweave.net

# ==============================================
# Decentralized Identity (DID)
# ==============================================

# Ceramic Network
CERAMIC_API_URL=https://ceramic-clay.3boxlabs.com
DID_PRIVATE_KEY=your_did_private_key_hex

# ==============================================
# Oracle Services
# ==============================================

# Chainlink
CHAINLINK_VRF_COORDINATOR=
CHAINLINK_KEY_HASH=
CHAINLINK_SUBSCRIPTION_ID=

# ==============================================
# Cross-Chain Bridge Services
# ==============================================

# Wormhole
NEXT_PUBLIC_WORMHOLE_RPC_HOSTS=["https://wormhole-v2-testnet-api.certus.one"]
WORMHOLE_GUARDIAN_RPC=https://wormhole-v2-testnet-api.certus.one

# Bridge Fee Configuration
BRIDGE_FEE_RECIPIENT=your_fee_recipient_address

# ==============================================
# Database Configuration (Optional)
# ==============================================

DATABASE_URL=postgresql://username:password@localhost:5432/omniflow
REDIS_URL=redis://localhost:6379

# ==============================================
# Application Configuration
# ==============================================

# Environment
NODE_ENV=development
# Options: development, staging, production

# ==============================================
# Security & Monitoring
# ==============================================

# JWT Secret (generate with: openssl rand -hex 32)
JWT_SECRET=your_jwt_secret_here

# Encryption Key (generate with: openssl rand -hex 32)
ENCRYPTION_KEY=your_encryption_key_here

# ==============================================
# Testing & Development
# ==============================================

# Enable/disable gas reporting
REPORT_GAS=false

# ==============================================
# Notes & Best Practices
# ==============================================

# 1. NEVER commit the actual .env file to Git
# 2. Use different keys for development, staging, and production
# 3. Rotate keys regularly (monthly for production)
# 4. Use environment-specific API keys (testnet vs mainnet)
# 5. Keep backups of production keys in a secure vault (1Password, AWS Secrets Manager, etc.)
# 6. For production deployment, use hardware wallets or multi-sig for PRIVATE_KEY operations
# 7. Validate all environment variables on application startup
# 8. Use minimal permissions for API keys (principle of least privilege)
